# Generated by WARP. Do not edit: regenerated on every rogue AP start.
#
# Stock hostapd with an external RADIUS backend. All EAP logic - certificate
# presentation, method negotiation, credential capture - lives in WARP's own
# RADIUS server, so no patched hostapd-wpe is needed.

interface=wlan1
ssid=CORP-8021X
channel=6
hw_mode=g
country_code=GB
ieee80211d=1

# WPA2-Enterprise.
wpa=2
wpa_key_mgmt=WPA-EAP
wpa_pairwise=CCMP
rsn_pairwise=CCMP

# 802.1X relayed to WARP's RADIUS server. These three lines are the whole
# reason a patched hostapd is unnecessary.
ieee8021x=1
eapol_version=2
auth_server_addr=127.0.0.1
auth_server_port=1812
auth_server_shared_secret=warp-test-secret
own_ip_addr=127.0.0.1
nas_identifier=warp-corp-8021x

# Operational.
logger_stdout=-1
logger_stdout_level=2
ctrl_interface=/var/run/hostapd-warp
ctrl_interface_group=0
ignore_broadcast_ssid=0
macaddr_acl=0
auth_algs=1
